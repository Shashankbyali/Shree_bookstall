# Owner login. There is no default: login fails with 503 until these are set.
# Use a long, unguessable password — this is the only thing protecting customer
# names, phone numbers and uploaded documents.
OWNER_USERNAME="owner"
OWNER_PASSWORD=""

# Signs the owner session cookie and the short-lived upload tickets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Public URL used for QR codes. Must be the deployed domain in production,
# otherwise the counter QR points customers at localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (required — database + file storage)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_BUCKET="print-files"
# Service role key: server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
