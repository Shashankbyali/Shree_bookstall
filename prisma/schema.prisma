generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PrintJob {
  id        String   @id @default(cuid())
  name      String
  phone     String
  notes     String?
  status    String   @default("pending") // pending | processing | ready | completed | cancelled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files     PrintFile[]
}

model PrintFile {
  id           String   @id @default(cuid())
  jobId        String
  job          PrintJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  originalName String
  storedName   String
  mimeType     String
  size         Int
  enhanced     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
